# Echelix NVIDIA NIM template for Free Claude Code.
#
# FCC keeps its configuration in ONE managed file: ~/.fcc/.env
#   mkdir -p ~/.fcc && cp .env.nvidia.example ~/.fcc/.env
# A repo-local .env is imported into ~/.fcc/.env once on first start, then ignored.
# Edit values in the Admin UI (http://localhost:8082/admin) or in ~/.fcc/.env, then
# restart the proxy (fcc-stop && fcc-start).

# ---- Provider credentials ------------------------------------------------------------
NVIDIA_NIM_API_KEY="<your nvidia key>"
# OPENROUTER_API_KEY=<your-token>

# ---- Model routing (provider/org/model) ----------------------------------------------
# Sonnet carries most Claude Code traffic; Opus handles reasoning-heavy tasks.
MODEL="nvidia_nim/qwen/qwen3-next-80b-a3b-thinking"
MODEL_OPUS="nvidia_nim/qwen/qwen3-next-80b-a3b-thinking"
MODEL_SONNET="nvidia_nim/qwen/qwen3.5-397b-a17b"
MODEL_HAIKU="nvidia_nim/qwen/qwen3.5-122b-a10b"
# Optional ordered fallbacks when a provider/model fails before producing output.
# MODEL_FALLBACKS="nvidia_nim/qwen/qwen3.5-122b-a10b"

# ---- Reasoning ------------------------------------------------------------------------
# Root policy: off | client | low | medium | high | xhigh | max. Route overrides add inherit.
# "client" preserves the effort Claude Code asks for; off disables thinking for that tier.
REASONING_POLICY=client
REASONING_OPUS=inherit
REASONING_SONNET=off
REASONING_HAIKU=off

# ---- Proxy authentication (required for a proxy bound to 0.0.0.0) ---------------------
# Generate a token with: openssl rand -base64 32
PROXY_AUTH_ENABLED=true
ANTHROPIC_AUTH_TOKEN="<secure auth token generated with openssl rand -base64 32>"
# Bind to loopback only if nothing else on your network needs the proxy.
# HOST=127.0.0.1
PORT=8082

# ---- Rate limiting and timeouts --------------------------------------------------------
PROVIDER_RATE_LIMIT=40
PROVIDER_RATE_WINDOW=60
PROVIDER_MAX_CONCURRENCY=5
HTTP_READ_TIMEOUT=180
HTTP_WRITE_TIMEOUT=10
HTTP_CONNECT_TIMEOUT=2

# ---- Headless background workflow ------------------------------------------------------
# fcc-start runs the proxy detached; do not pop the Admin UI in a browser on every start.
FCC_OPEN_BROWSER=false

# ---- Logging (~/.fcc/logs/server.log) --------------------------------------------------
LOG_LEVEL=INFO
LOG_API_ERROR_TRACEBACKS=true
# Echelix: set false to keep an append-only audit trail across restarts.
TRUNCATE_LOG_ON_START=true

# ---- Messaging bots stay disabled ------------------------------------------------------
MESSAGING_PLATFORM="none"
MESSAGING_RATE_LIMIT=1
